# Copy to .env and fill in to enable one-click sign-in. Leave blank to build without it
# (calendar links / .ics files still work). See docs/SETUP_GOOGLE.md and docs/SETUP_MICROSOFT.md.

# Origin of your deployed OAuth broker (apps/web), e.g. https://when2meet-sync.example.org
WXT_GOOGLE_BROKER_URL=

# Application (client) id of your Microsoft Entra app registration
WXT_MICROSOFT_CLIENT_ID=

# Optional: public key from the Chrome Web Store item, to keep the same extension id in dev builds
# W2M_EXTENSION_KEY=
